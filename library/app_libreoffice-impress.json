    {
      "title": "Slide Show",
      "shortcuts": [
        {
          "keys": "F5",
          "action": "Start presentation from first slide"
        },
        {
          "keys": "Shift + F5",
          "action": "Start presentation from current slide"
        },
        {
          "keys": "Esc",
          "action": "End slide show"
        },
        {
          "keys": "Page Down",
