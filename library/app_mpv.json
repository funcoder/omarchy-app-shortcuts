    {
      "title": "Playback",
      "shortcuts": [
        {
          "keys": "Space",
          "action": "Play / pause"
        },
        {
          "keys": "Left",
          "action": "Seek backward 5 seconds"
        },
        {
          "keys": "Right",
          "action": "Seek forward 5 seconds"
        },
        {
          "keys": "Down",
          "action": "Seek backward 1 minute"
        },
        {
          "keys": "Up",
          "action": "Seek forward 1 minute"
