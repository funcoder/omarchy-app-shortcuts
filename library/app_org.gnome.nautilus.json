        {
          "keys": "Ctrl + A",
          "action": "Select all files"
        },
        {
          "keys": "Ctrl + Shift + A",
          "action": "Deselect all files"
        },
        {
          "keys": "Ctrl + I",
          "action": "Invert selection"
        },
        {
          "keys": "Arrow keys",
          "action": "Move selection cursor"
        },
        {
          "keys": "Space",
          "action": "Preview selected file"
        }
      ]
    },
    {
      "title": "View",
      "shortcuts": [
        {
          "keys": "Ctrl + 1",
          "action": "Use list view"
        },
        {
          "keys": "Ctrl + 2",
          "action": "Use grid view"
        },
        {
          "keys": "Ctrl + Plus",
          "action": "Zoom in / increase icon size"
        },
        {
          "keys": "Ctrl + Minus",
          "action": "Zoom out / decrease icon size"
