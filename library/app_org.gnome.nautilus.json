{
  "key": "app:org.gnome.nautilus",
  "name": "Files",
  "sections": [
    {
      "title": "Navigation",
      "shortcuts": [
        {
          "keys": "Ctrl + L",
          "action": "Type a location/path to go to"
        },
        {
          "keys": "Alt + Up",
          "action": "Go to parent folder"
        },
        {
          "keys": "Alt + Left",
          "action": "Go back"
        },
        {
          "keys": "Alt + Right",
          "action": "Go forward"
        },
        {
          "keys": "Alt + Home",
          "action": "Go to home folder"
        },
        {
          "keys": "Ctrl + H",
          "action": "Toggle hidden files"
        },
        {
          "keys": "F5",
          "action": "Refresh view"
        },
        {
          "keys": "Escape",
          "action": "Stop loading/cancel"
        }
      ]
    },
    {
      "title": "Tabs and Windows",
      "shortcuts": [
        {
          "keys": "Ctrl + T",
          "action": "Open new tab"
        },
        {
          "keys": "Ctrl + N",
          "action": "Open new window"
        },
        {
          "keys": "Ctrl + W",
          "action": "Close tab/window"
        },
        {
          "keys": "Ctrl + Tab",
