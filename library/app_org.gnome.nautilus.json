    },
    {
      "title": "Search",
      "shortcuts": [
        {
          "keys": "Ctrl + F",
          "action": "Search current folder"
        },
        {
          "keys": "Escape",
          "action": "Close search"
        }
      ]
    },
    {
      "title": "Properties and Info",
      "shortcuts": [
        {
          "keys": "Alt + Enter",
          "action": "Show properties of selected item"
        },
        {
          "keys": "F9",
          "action": "Toggle sidebar"
        }
      ]
