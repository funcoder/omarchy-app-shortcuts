        },
        {
          "keys": "Ctrl + X",
          "action": "Cut selected files"
        },
        {
          "keys": "Ctrl + V",
          "action": "Paste files"
        },
        {
          "keys": "Delete",
          "action": "Move to trash"
        },
        {
          "keys": "Ctrl + Shift + Delete",
          "action": "Permanently delete"
        },
        {
          "keys": "F2",
          "action": "Rename selected item"
        },
        {
          "keys": "Ctrl + Shift + N",
          "action": "Create new folder"
        },
        {
          "keys": "Ctrl + D",
          "action": "Bookmark selected location"
        },
        {
          "keys": "Ctrl + Z",
